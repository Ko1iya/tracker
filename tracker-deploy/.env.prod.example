# Шаблон прод-секретов. Скопируй в .env.prod и заполни реальными значениями.
# .env.prod в git НЕ коммитится (см. .gitignore) — он живёт только на сервере.

# --- Домен и почта для Let's Encrypt ---
DUCKDNS_DOMAIN=budget-tracker.duckdns.org
CERTBOT_EMAIL=you@example.com

# --- PostgreSQL (контейнер db) ---
POSTGRES_USER=myuser
POSTGRES_PASSWORD=поменяй_на_надёжный_пароль
POSTGRES_DB=budget_db

# --- Бэк (budget-api) ---
# Хост базы = имя сервиса из compose (db), порт внутренний 5432.
# Значения user/password/db должны совпадать с POSTGRES_* выше.
DATABASE_URL=postgresql://myuser:поменяй_на_надёжный_пароль@db:5432/budget_db?schema=public

# Сгенерируй НОВЫЙ секрет для прода: openssl rand -hex 64
JWT_SECRET=замени_на_вывод_openssl_rand_hex_64
JWT_EXPIRES_IN=7d

# Ключи внешних AI-сервисов голосового ввода (перенеси из локального .env бэка).
NEXARA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Отладочный лог голосового ввода — в проде держим выключенным.
DEBUG_VOICE=false

# Фронт и API за одним origin, поэтому CORS в проде не нужен. Оставь пустым,
# чтобы бэк не слал CORS-заголовки (same-origin их и не требует). Заполни,
# только если фронт переедет на отдельный домен (через запятую несколько).
CORS_ORIGIN=
